{
  "default_language": "ru_ru",
  "targets": [
    {
      "path": "config/fancymenu",
      "lang_files": ["fancymenu"]
    },
    {
      "path": "config/ftbquests",
      "lang_files": ["ftbquests"]
    },
    {
      "path": "config/puffish_skills",
